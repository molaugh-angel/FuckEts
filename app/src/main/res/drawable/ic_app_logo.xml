<?xml version="1.0" encoding="utf-8"?>
<!--
  应用标志（矢量图，48dp 画布）：圆形玻璃底 + 一张试卷 + 三条彩色内容行。
  三行颜色对应 Part A / B / C 的主题色（蓝 / 紫 / 绿），与列表内配色呼应。
  纯 path 绘制，任意尺寸不失真；如需换色只改 @color/part_*_accent。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 圆形玻璃底盘 -->
    <path
        android:fillColor="@color/part_a_bg"
        android:pathData="M24,2 A22,22 0 1 1 24,46 A22,22 0 1 1 24,2 Z"
        android:strokeWidth="1.5"
        android:strokeColor="@color/part_a_accent" />

    <!-- 试卷卡：白色半透明 + 主色描边 -->
    <path
        android:fillAlpha="0.72"
        android:fillColor="#FFFFFF"
        android:pathData="M17,12 H31 A3,3 0 0 1 34,15 V33 A3,3 0 0 1 31,36 H17 A3,3 0 0 1 14,33 V15 A3,3 0 0 1 17,12 Z"
        android:strokeWidth="1.6"
        android:strokeColor="@color/part_a_accent" />

    <!-- 三条内容行：A 蓝 / B 紫 / C 绿 -->
    <path
        android:pathData="M18.5,19 H29.5"
        android:strokeLineCap="round"
        android:strokeColor="@color/part_a_accent"
        android:strokeWidth="3" />
    <path
        android:pathData="M18.5,25 H29.5"
        android:strokeLineCap="round"
        android:strokeColor="@color/part_b_accent"
        android:strokeWidth="3" />
    <path
        android:pathData="M18.5,31 H25.5"
        android:strokeLineCap="round"
        android:strokeColor="@color/part_c_accent"
        android:strokeWidth="3" />
</vector>
